# 1. AUTHENTICATION PROVIDER SELECTION
# Supported: "supabase" | "firebase" | "demo"
VITE_AUTH_PROVIDER=demo

# 2. SUPABASE AUTH CONFIGURATION (Optional - if using Supabase)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 3. FIREBASE AUTH CONFIGURATION (Optional - if using Firebase)
VITE_FIREBASE_API_KEY=AIzaSyA...
VITE_FIREBASE_AUTH_DOMAIN=seems-ai-dalma.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=seems-ai-dalma
VITE_FIREBASE_STORAGE_BUCKET=seems-ai-dalma.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=1234567890
VITE_FIREBASE_APP_ID=1:1234567890:web:abcdef123456

# 4. SYSTEM TELEMETRY & GATEWAY METRICS
VITE_APP_VERSION=5.2.0
VITE_CORRIDOR_SECTOR=NH-33 Dalma Wildlife Sanctuary (Jharkhand)
VITE_SESSION_TIMEOUT_MINUTES=60
