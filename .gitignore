# ==========================================
# Elephant Guard Monorepo Git Ignore Rules
# ==========================================

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini
*.tmp

# Environment and Secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key

# ------------------------------------------
# Python / Backend
# ------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
env.bak/
venv.bak/
*.sqlite3
*.db-journal
.pytest_cache/
.coverage
htmlcov/

# ------------------------------------------
# Node / React / TypeScript / Vite
# ------------------------------------------
node_modules/
dist/
dist-ssr/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ------------------------------------------
# Android / Gradle
# ------------------------------------------
.gradle/
build/
*/build/
*/*/build/
*.apk
*.aab
*.ap_
*.dex
*.class
captures/
.externalNativeBuild/
.cxx/
local.properties
*.hprof

# ------------------------------------------
# IDE / Editor Files
# ------------------------------------------
.idea/
*.iml
*.ipr
*.iws
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.sublime-project
*.sublime-workspace
